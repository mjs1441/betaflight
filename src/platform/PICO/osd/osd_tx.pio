// .pio_version 1 // maybe

.program osd_tx

;
; h pixels	360
; h display (us)	48
; clocks / pixel	10
; 
; sysclock MHz	150			
; pixels / us	7.5		us / pixel	0.133333333
; clocks / us	75		us / clock	0.013333333
; clock divider	2			
; 
; wait ensure vsync	10	750.00
; wait ensure >= hsync	3.4	255.00 (could go a bit lower, want > 2.35 us)
; hsync + back porch	10.4	780.00
; hsync + back porch + left margin	12.375	928.13

; (1 + hshiftA) * (1 + hshiftB) ~= 928 less change
.define hshiftA 24
.define hshiftB 26

;;; *** must arrange ISR to contain 359 = h pixels - 1
;; stop (or not started yet), clear fifos
;; send 359 to SM (put in TX fifo)
;; pio_sm_exec_wait_blocking(pio, sm, [pull])
;; pio_sm_exec_wait_blocking(pio, sm, [mov isr, osr])

start:
    irq 0                    ; set IRQ, don't wait (signal for DMA to restart)
    set PINS, 0              ; set OSD_W and OSD_EN pins to 0 ;;; **** probably remove from here
await_vsync:
    wait 1 PIN, 0            ; wait for high on the sync pin
detected_vsync:
    wait 0 PIN, 0            ; transition to low on the sync pin, then delay
    set  y, 22     [12]
d1: jmp  y--, d1   [31]
    jmp PIN, await_vsync     ; too short (high after 750 clocks = 10us), wasn't vsync

    wait 1 PIN, 0            ; wait out until end of that long pulse
    set x, 31                ; start writing out after the 33nd hsync (wait 32 here, 1 below)
loop_hsync:
    set y, 15
    wait 0 PIN, 0  [9]
d2: jmp y--, d2    [14]      ; wait 16*15 + 10
    jmp PIN, loop_hsync      ; too short (high after ~251clocks ~3.4us, maybe short sync pulse)
    set y, hshiftA
d3: jmp y--, d3    [hshiftB] ; wait from low total of 16*15+10+2+25*27 = 927 ~ 12.375us
    jmp PIN, lh_cont
    jmp loop_hsync           ; looks like another vsync pulse, don't count it, look again for hsync
        ; TODO *** maybe better loop to wait, set x,31
lh_cont:
    jmp x--, loop_hsync



;;;    set x, 31 ; want 255
;;;    mov osr, ~NULL
;;;    out x, 8             ; shift 8 bits of 1s into x, happens to be 255
    mov x, isr ; prepared 255 (or num lines)

;;      set x, 10 ;;;; *** TESTING
      
wait_next_hsync:
    wait 0 PIN, 0
    set y, 27   [23] ;; TESTING;;;    set y, 29   [23]
d4: jmp y--, d4 [29]     ; until set would be 4 + 24 + 30*30 = 928 (sub 2 more if pull, out)
    jmp PIN, next_line
    jmp start ; looks like are in a vsync pulse


next_line:
  ;;;;    mov y, isr               ; pre-arranged (number of pixels in line - 1) = 359
   ;;;;    ; **** that will go away, become 22.5 -1 (23-1) when do extra pull, jmp !osre loop for word based
   set y, 22 ; (num words of pixel data in line) - 1


image appears as ~ half width, but we are writing for too long on each line?

;;    set PINS, 3
;; black   set PINS, 2 ;;;; TESTING ;;;; out PINS, 2        ; shift 2 bits from OSR to PINS offset 0, offset 1 (OSD_W and OSD_EN)

line_loop:
    pull noblock
d6: out PINS, 2        ; shift 2 bits from OSR to PINS offset 0, offset 1 (OSD_W and OSD_EN)
    jmp !osre d6        [8]
    jmp y--, line_loop  [7]   ; 10 clocks per pixel


;; dithered 75% grey
;; set PINS, 2 [2]
;;    set PINS, 3 
;;    jmp y--, line_loop [4]

;; will be...
;; pull
;; out pins,2
;; jmp !osre [out pins] [dd]
;; jmp y--, [pull]      [dd]
;; then osr is otherwise free

   set PINS, 0
   jmp x--, wait_next_hsync
   ; that's a wrap


; pio_sm_set_in_pins   OSD_SYNC        <--- IN, mov blah PINS, and WAIT PIN
; pio_sm_set_jmp_pin   OSD_SYNC        <--- jmp PIN
; pio_sm_set_set_pins  OSD_W, OSD_EN   <--- set PINS 
; pio_sm_set_out_pins  OSD_W, OSD_EN   <--- OUT, mov PINS blah
